{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "last_modified": { "type": "string", "format": "date-time" },
    "author": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "draft", "archived", "deprecated"] },
    "category": { "type": "string", "enum": ["00-Meta", "10-Product", "20-Architecture", "30-Engineering", "40-Operations", "90-Archive"] },
    "tags": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["title", "created_at", "last_modified", "author", "status", "category"]
}
