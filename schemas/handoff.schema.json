{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "task_id": { "type": "string", "pattern": "^T-[A-Z0-9]+-[0-9]+$" },
    "agent": { "type": "string" },
    "model": { "type": "string" },
    "status": { "type": "string" },
    "target_repo": { "type": "string" },
    "branch": { "type": "string" },
    "base_sha": { "type": "string" },
    "head_sha": { "type": "string" },
    "evidence_output": { "type": "string", "minLength": 10 },
    "peer_review_notes": { "type": ["string", "null"] },
    "human_action_required": { "type": ["string", "null"] }
  },
  "required": ["task_id", "agent", "model", "status", "target_repo", "branch", "base_sha", "head_sha", "evidence_output"]
}
