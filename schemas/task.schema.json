{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^T-[A-Z0-9]+-[0-9]+$" },
    "title": { "type": "string", "minLength": 5 },
    "repo": { "type": "string", "minLength": 1 },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
    "lane": { "type": "string", "enum": ["ANY", "gemini", "claude", "codex", "HUMAN", "AUDITOR"] },
    "status": { "type": "string", "enum": ["DRAFT", "OPEN", "AUDITED", "CLAIMED", "IN_PROGRESS", "BLOCKED", "PEER_REVIEW", "HUMAN_REVIEW", "DONE", "DEFERRED", "CANCELLED"] },
    "owner": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "audited_at": { "type": ["string", "null"], "format": "date-time" },
    "audited_by": { "type": ["string", "null"] },
    "audited_repo_sha": { "type": ["string", "null"] },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "definition_of_done": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "verification_command": { "type": ["string", "null"] },
    "human_review_required": { "type": "boolean" },
    "claimed_at": { "type": ["string", "null"], "format": "date-time" },
    "last_transition": { "type": ["string", "null"], "format": "date-time" }
  },
  "required": ["id", "title", "repo", "priority", "lane", "status", "created_at", "scope", "definition_of_done"],
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["AUDITED", "CLAIMED", "IN_PROGRESS", "PEER_REVIEW", "HUMAN_REVIEW", "DONE"] } }
      },
      "then": {
        "required": ["audited_at", "audited_by", "audited_repo_sha", "verification_command"]
      }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["CLAIMED", "IN_PROGRESS", "PEER_REVIEW", "HUMAN_REVIEW", "DONE"] } }
      },
      "then": {
        "required": ["owner"],
        "properties": { "owner": { "type": "string", "minLength": 1 } }
      }
    }
  ]
}
